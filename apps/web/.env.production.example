# Web — producción
# Copiar como .env.production o cargar estas variables en Vercel.
# VITE_* se inyecta al construir: hay que redeployar después de cambiarlas.

# Incluir /api al final.
VITE_API_URL=https://REPLACE_API_DOMAIN/api

VITE_HCAPTCHA_SITE_KEY=REPLACE_WITH_HCAPTCHA_SITE_KEY

# Código de acceso de la demo pública de Riot. No es una credencial real.
VITE_RIOT_DEMO_ACCESS_CODE=REPLACE_WITH_DEMO_ACCESS_CODE
