# Server
PORT=3000
NODE_ENV=development
# Number of reverse proxies in front of Express (Render/Railway = 1).
TRUST_PROXY=1
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173
# Canonical public URL of the web app, used for emails and links.
APP_URL=http://localhost:5173

# Database
DB_URI=postgresql://duo_lol:duo_lol123@localhost:5433/duo_lol
# Used by the test suite when NODE_ENV=test (keeps development data untouched).
TEST_DB_URI=postgresql://duo_lol:duo_lol123@localhost:5433/duo_lol_test

# JWT
SECRET_JWT_SEED=change_this_to_a_random_string_of_at_least_64_characters
JWT_EXPIRE_IN=1d

# Captcha (hCaptcha). Optional in development and test.
# HCAPTCHA_SECRET=

# Email (Resend). Optional in development.
# RESEND_API_KEY=
# En modo test de Resend usar onboarding@resend.dev y enviar a la casilla dueña.
# OWNER_EMAIL=onboarding@resend.dev
# TEST_EMAIL_TO=tu-casilla@dominio.com
SUPPORT_EMAIL=soporte@duolas.online

# Web push (VAPID). Required only when push is enabled.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@duolas.online

# Riot API. Not used by the MVP; server-side only when a production key is approved.
# RIOT_API_KEY=
# RIOT_PLATFORM=la2
# RIOT_REGION=americas
# RIOT_API_TIMEOUT_MS=8000

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_USER_MAX=600

# Logging
LOG_LEVEL=info

# Admin seed
# ADMIN_EMAIL=admin@duolas.online
# ADMIN_PASSWORD=change_this_password
