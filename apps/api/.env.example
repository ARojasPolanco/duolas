# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173
# Canonical public URL of the web app, used for emails and links.
APP_URL=http://localhost:5173

# Database
DB_URI=postgresql://duo_lol:duo_lol123@localhost:5433/duo_lol
# Used by the test suite when NODE_ENV=test (keeps development data untouched).
TEST_DB_URI=postgresql://duo_lol:duo_lol123@localhost:5433/duo_lol_test

# JWT
SECRET_JWT_SEED=change_this_to_a_random_string_of_at_least_64_characters
JWT_EXPIRE_IN=1d

# Captcha (hCaptcha). Optional in development and test.
# HCAPTCHA_SECRET=

# Email (Resend). Optional in development.
# RESEND_API_KEY=
# OWNER_EMAIL=onboarding@resend.dev
SUPPORT_EMAIL=soporte@duolas.app

# Web push (VAPID). Required only when push is enabled.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@duolas.app

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Admin seed
# ADMIN_EMAIL=admin@duolas.app
# ADMIN_PASSWORD=change_this_password
